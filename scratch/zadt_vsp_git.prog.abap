CLASS kHGwlvrpxwdUTiJUSNzxhvMTMsAVCJ IMPLEMENTATION.

  METHOD load.

    DATA lo_taskdef TYPE REF TO kHGwlvrpxwdUTiJUSNzxhvMTMsAVCJ.

    CREATE OBJECT lo_taskdef.
    lo_taskdef->mv_objid = iv_objid.
