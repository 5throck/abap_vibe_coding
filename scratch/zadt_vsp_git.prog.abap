    RETURN.
  ENDMETHOD.
  METHOD zif_abapgit_object~get_deserialize_steps.
    APPEND zif_abapgit_object=>gc_step_id-abap TO rt_steps.
  ENDMETHOD.
  METHOD zif_abapgit_object~get_metadata.
