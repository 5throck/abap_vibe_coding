* renamed: zcl_abapgit_flow_git :: lcl_sha1_stack
CLASS kHGwlqeiVzSltVlvDZbkhPIfZcUzJG DEFINITION.
  PUBLIC SECTION.
    METHODS clear
      RETURNING
        VALUE(ro_stack) TYPE REF TO kHGwlqeiVzSltVlvDZbkhPIfZcUzJG.

    METHODS push
      IMPORTING
        iv_sha1 TYPE zif_abapgit_git_definitions=>ty_sha1.

    METHODS pop
      RETURNING
        VALUE(rv_sha1) TYPE zif_abapgit_git_definitions=>ty_sha1.

    METHODS size
      RETURNING
        VALUE(rv_size) TYPE i.
  PRIVATE SECTION.
