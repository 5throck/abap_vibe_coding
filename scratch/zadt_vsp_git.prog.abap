ENDCLASS.

CLASS kHGwlqeiVzSltVlvDZbkhPIfZcUzJG IMPLEMENTATION.
  METHOD clear.
    CLEAR mt_list.
    ro_stack = me.
  ENDMETHOD.

  METHOD push.
