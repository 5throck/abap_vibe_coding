                ro_result   = lo_dsfi_source_container.

            CALL METHOD lo_dsfi_source_container->('IF_DD_DSFI_SRC_CONTAINER~GET_AS4USER')
              RECEIVING
                rv_result = rv_user.
          ENDIF.
        ENDIF.

      CATCH cx_root INTO lx_error.
        zcx_abapgit_exception=>raise_with_text( lx_error ).
